# =====================================================================
# Upskill Recommender Backend Environment Variables Configuration
# Copy this file to .env and fill in your secure credentials.
# DO NOT COMMIT YOUR ACTUAL .env FILE TO VERSION CONTROL!
# =====================================================================

# Gemini API Key (Required for AI metadata, explanations, and dynamic roadmap generation)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Allowed CORS Origins (Comma-separated list of exact origin domains without trailing slashes)
# In production, specify your exact frontend domain (e.g., https://upskill-portfolio.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional path for the persistent emerging-role cache
# ROLE_EXPANSION_DB_PATH=backend/data/role_expansions.sqlite3
